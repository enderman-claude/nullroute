#!/bin/sh
# shellcheck disable=SC1091,SC2034  # libs are sourced by path; NR_WORLD is read by missions.sh
# nullroute - a terminal hacking game written in POSIX sh.
#
# Usage: nullroute [-n] [-s DIR] [-h] [-V]
#   -n       start a new game (erases the saved state)
#   -s DIR   keep save data in DIR (default: $NULLROUTE_HOME or ~/.local/state/nullroute)
#   -h       show help
#   -V       show version
#
# Works with any POSIX shell (dash, bash --posix, busybox ash, ksh, zsh in
# sh emulation). No bashisms.

set -u

NR_BIN=$(cd "$(dirname "$0")" && pwd)
NR_ROOT=$(cd "$NR_BIN/.." && pwd)
NR_WORLD="$NR_ROOT/world"

. "$NR_ROOT/lib/core.sh"
. "$NR_ROOT/lib/vfs.sh"
. "$NR_ROOT/lib/net.sh"
. "$NR_ROOT/lib/missions.sh"
. "$NR_ROOT/lib/shell.sh"

usage() {
	cat <<USAGE
usage: nullroute [-n] [-s DIR] [-h] [-V]

  -n       start a new game (erases saved progress)
  -s DIR   save directory (default: \$NULLROUTE_HOME or ~/.local/state/nullroute)
  -h       show this help
  -V       show version
USAGE
}

main() {
	_new=0
	_state=
	while getopts "nhVs:" _opt; do
		case $_opt in
			n) _new=1 ;;
			s) _state=$OPTARG ;;
			V) say "nullroute $NR_VERSION"; return 0 ;;
			h) usage; return 0 ;;
			*) usage >&2; return 2 ;;
		esac
	done
	shift $((OPTIND - 1))

	nr_paths "$_state"

	if [ "$_new" = 1 ]; then
		case $NR_STATE in
			''|/) die "refusing to reset '$NR_STATE'" ;;
		esac
		rm -rf "$NR_STATE"
	fi

	game_init
	if [ -n "$(state_get ended)" ]; then
		say "Your last game ended ($(state_get ended)). Start a new one with: nullroute -n"
		return 0
	fi
	session_reset
	repl
	return 0
}

main "$@"
